# Wrangler 4.160+ declares a peerOptional on @cloudflare/workers-types ^5,
# while this project intentionally keeps ^4 for the Workers/D1 typings used in
# tsconfig.json. Relax strict peer resolution so a root-level `npm install`
# (which Vercel may run) does not fail with ERESOLVE.
legacy-peer-deps=true
